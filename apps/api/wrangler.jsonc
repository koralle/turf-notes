{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turf-notes-api",
  "main": "./src/index.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "TURSO_CONNECTION_URL",
      "TURSO_AUTH_TOKEN",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
    ],
  },
}
