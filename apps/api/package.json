    "enable-password": "tsx scripts/enable-password.ts",
    "set-password": "tsx scripts/set-password.ts",
    "test": "vitest run",
    "typecheck": "tsrs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:auth",
    "@better-auth/passkey": "catalog:auth",
    "@orpc/server": "catalog:rpc",
