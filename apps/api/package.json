    "uuidv7": "catalog:db",
    "valibot": "catalog:rpc"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@turf-notes/forge": "workspace:*",
    "@types/node": "catalog:typescript",
    "tsrs": "catalog:typescript",
    "tsx": "catalog:tooling",
