{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turf-notes",
  "main": "./src/server.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "services": [{ "binding": "API", "service": "turf-notes-api" }],
}
