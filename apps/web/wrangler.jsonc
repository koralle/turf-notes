{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turf-notes",
  "main": "./src/server.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "turf-notes.koralle-mgmg.com",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "services": [{ "binding": "API", "service": "turf-notes-api" }],
}
