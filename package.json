{
  "name": "@turf-notes/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "ultracite check --type-aware",
    "deploy": "pnpm --filter @turf-notes/api run deploy && pnpm --filter @turf-notes/web run deploy",
    "deploy:api": "pnpm --filter @turf-notes/api run deploy",
    "deploy:web": "pnpm --filter @turf-notes/web run deploy",
    "dev": "pnpm --filter @turf-notes/web run dev",
    "fix": "ultracite fix --type-aware --no-error-on-unmatched-pattern",
    "knip": "knip",
    "test": "pnpm -r run test",
    "typecheck": "tsc && pnpm -r run typecheck"
  },
  "devDependencies": {
    "@turf-notes/forge": "workspace:*",
    "knip": "catalog:tooling",
    "lefthook": "catalog:tooling",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "typescript": "catalog:typescript",
    "ultracite": "catalog:lint"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
