{
  "name": "@turf-notes/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run //#check:ultracite",
    "check:ultracite": "ultracite check --type-aware --deny-warnings --report-unused-disable-directives",
    "deploy": "pnpm --filter @turf-notes/api run deploy && pnpm --filter @turf-notes/web run deploy",
    "deploy:api": "pnpm --filter @turf-notes/api run deploy",
    "deploy:web": "pnpm --filter @turf-notes/web run deploy",
    "dev": "turbo run dev --filter=@turf-notes/web",
    "doctor": "react-doctor --no-telemetry",
    "fix": "turbo run panda:codegen && ultracite fix --type-aware --no-error-on-unmatched-pattern",
    "knip": "turbo run //#knip:run",
    "knip:run": "knip",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck //#typecheck:root",
    "typecheck:root": "tsrs"
  },
  "devDependencies": {
    "@tanstack/intent": "catalog:tooling",
    "@turf-notes/forge": "workspace:*",
    "chrome-devtools-mcp": "catalog:tooling",
    "knip": "catalog:tooling",
    "lefthook": "catalog:tooling",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "react-doctor": "catalog:tooling",
    "tsrs": "catalog:typescript",
    "turbo": "catalog:tooling",
    "ultracite": "catalog:lint"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "intent": {
    "skills": [
      "@tanstack/*",
      "drizzle-kit",
      "ultracite"
    ]
  }
}
